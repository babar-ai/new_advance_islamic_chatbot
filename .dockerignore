# Virtual environments
.venv/
venv/
env/

# Git
.git/
.gitignore

# Python cache
__pycache__/
*.py[cod]
*.pytest_cache/

# Local data volumes (mounted via docker-compose, not baked into image)
qdrant_storage/
qdrant_data/
redis_data/

# Logs (created at runtime)
logs/

# Evaluation results
evaluation/results/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets — injected via docker-compose env_file, never baked in
.env
.env.*
*.pem
*.key
*.pub

# Raw vector store source files (not needed inside runtime app container)
backend/vector_store/storage/

# Flashrank model cache
flashrank_cache/
/tmp/flashrank_cache/

# LangGraph Studio local state
.langgraph_api/
.agents/
.gemini/

# Demo / docs
demo_app.py
linkedin_demo_script.md
workflows/
README.md

# Frontend has its own Dockerfile and should not be copied into Python container
frontend/

# Large archive files
*.tar.gz
*.tar
*.zip
